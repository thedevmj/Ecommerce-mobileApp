  "typography": {
    "fontFamily": {
      "regular": "Inter_400Regular",
      "medium": "Inter_500Medium",
      "semibold": "Inter_600SemiBold",
      "bold": "Inter_700Bold"
    },
    "scale": {
      "display": { "fontSize": 34, "lineHeight": 40, "letterSpacing": -0.8, "fontWeight": "700" },
      "h1": { "fontSize": 28, "lineHeight": 34, "letterSpacing": -0.5, "fontWeight": "700" },
      "h2": { "fontSize": 24, "lineHeight": 30, "letterSpacing": -0.4, "fontWeight": "700" },
      "h3": { "fontSize": 20, "lineHeight": 26, "letterSpacing": -0.2, "fontWeight": "600" },
      "title": { "fontSize": 18, "lineHeight": 24, "letterSpacing": -0.2, "fontWeight": "600" },
      "body": { "fontSize": 16, "lineHeight": 24, "letterSpacing": 0, "fontWeight": "400" },
      "bodySmall": { "fontSize": 14, "lineHeight": 20, "letterSpacing": 0, "fontWeight": "400" },
      "caption": { "fontSize": 12, "lineHeight": 16, "letterSpacing": 0.1, "fontWeight": "500" },
      "overline": { "fontSize": 11, "lineHeight": 14, "letterSpacing": 1.2, "fontWeight": "600" }
    }
  },
  "space": {
    "0": 0, "1": 2, "2": 4, "3": 6, "4": 8, "5": 12, "6": 16, "7": 20,
    "8": 24, "9": 32, "10": 40, "11": 48, "12": 64
  },
  "radius": { "xs": 6, "sm": 10, "md": 14, "lg": 18, "xl": 24, "pill": 999 },
  "size": { "touchTarget": 44, "inputHeight": 48, "headerHeight": 56, "tabBarHeight": 64, "contentMaxWidth": 720 },
  "shadow": {
    "sm": { "shadowColor": "#0F172A", "shadowOffset": { "width": 0, "height": 1 }, "shadowOpacity": 0.05, "shadowRadius": 3, "elevation": 1 },
    "md": { "shadowColor": "#0F172A", "shadowOffset": { "width": 0, "height": 6 }, "shadowOpacity": 0.08, "shadowRadius": 16, "elevation": 4 },
    "lg": { "shadowColor": "#0F172A", "shadowOffset": { "width": 0, "height": 14 }, "shadowOpacity": 0.12, "shadowRadius": 28, "elevation": 8 }
  }
}
